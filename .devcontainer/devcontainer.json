// WorldSim "Unity workshop" Codespace: Unity Editor with real rendering (Xvfb + software
// OpenGL) + Unity MCP + Claude Code. How to use it, budget rules and the first-run spike:
// docs/CODESPACES.md.
//
// Why a small base image and not GameCI's Unity image: the Unity image unpacks to more than
// the ~14 GB the codespace host has free for Docker images, so container creation failed with
// "no space left on device" (2026-11-19). Instead, Tools/Unity/install-editor.sh downloads the
// exact Editor from Unity (changeset from ProjectVersion.txt) into /tmp: a large temporary disk
// that is not counted as codespace storage, re-filled on the first up.sh after each start.
{
  "name": "WorldSim Unity workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Unity needs real RAM: 4 cores / 16 GB is the smallest comfortable machine.
  // Free plan: 120 core-hours a month, i.e. about 30 hours on this machine.
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Codespaces secrets (user secrets with access to this repo). Never printed by any script.
  "secrets": {
    "UNITY_EMAIL": { "description": "Unity account email (same as the Actions secret)" },
    "UNITY_PASSWORD": { "description": "Unity account password (same as the Actions secret)" }
  },

  "containerEnv": {
    "UNITY_PATH": "/opt/unity",
    // Unity MCP only starts its bridge in batch mode when this is set.
    "UNITY_MCP_ALLOW_BATCH": "1",
    "UNITY_MCP_BIND_HOST": "127.0.0.1",
    // No usage telemetry from the MCP server or its Unity package.
    "DISABLE_TELEMETRY": "1",
    "UNITY_MCP_DISABLE_TELEMETRY": "1"
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/on-start.sh"
}
