<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders a generated world to PNG with the same Core sources the game uses (no Unity).
       Usage: see Program.cs header. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/WorldSim/Runtime/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../Assets/WorldSim/Runtime/Render/**/*.cs" LinkBase="Render" />
    <Compile Include="Program.cs" />
    <Compile Include="PackPreview.cs" />
  </ItemGroup>
</Project>
