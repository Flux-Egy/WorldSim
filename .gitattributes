* text=auto eol=lf
*.cs diff=csharp
# Unity YAML: let Unity's Smart Merge handle these if configured; never auto-merge as text.
*.unity    text merge=unityyamlmerge eol=lf
*.prefab   text merge=unityyamlmerge eol=lf
*.asset    text merge=unityyamlmerge eol=lf
*.meta     text eol=lf
# Binary assets
*.png binary
*.psd binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.so  binary
*.dll binary
*.keystore binary
